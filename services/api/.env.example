APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_SCHEME=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


VITE_APP_NAME="${APP_NAME}"
APP_NAME=Albuvo
APP_URL=http://localhost:8060
FRONTEND_URL=http://localhost:5174
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=albuvo
DB_USERNAME=albuvo
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY
REDIS_HOST=redis
QUEUE_CONNECTION=redis
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=LOCAL_ONLY
AWS_SECRET_ACCESS_KEY=LOCAL_ONLY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=albuvo-private-local
AWS_ENDPOINT=http://s3:9000
AWS_PUBLIC_ENDPOINT=http://localhost:9002
AWS_USE_PATH_STYLE_ENDPOINT=true
